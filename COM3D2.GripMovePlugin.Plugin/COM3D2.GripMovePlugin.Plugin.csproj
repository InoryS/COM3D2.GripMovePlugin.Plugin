<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="COM3D2.GameLibs" Version="2.43.1-r.0"/>
    <PackageReference Include="UnityEngine.Modules" IncludeAssets="compile" Version="5.6.4"/>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityInjector">
      <HintPath>..\libs\UnityInjector.dll</HintPath>
    </Reference>
    <Reference Include="ExIni">
      <HintPath>..\libs\ExIni.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="CM3D2\GripMovePlugin\Plugin\Resources\gripmovepluginshaders.bin">
      <LogicalName>CM3D2.GripMovePlugin.Plugin.Resources.gripmovepluginshaders.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="CM3D2\GripMovePlugin\Plugin\Resources\mouse_cursor.png">
      <LogicalName>CM3D2.GripMovePlugin.Plugin.Resources.mouse_cursor.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" Version="1.0.3"/>
  </ItemGroup>

  <PropertyGroup>
    <AssemblyTitle>GripMovePlugin</AssemblyTitle>
    <Copyright>Copyright © 2016</Copyright>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <Product>GripMovePlugin</Product>
    <Version>0.8.9.4</Version>
  </PropertyGroup>


  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>COM3D2.GripMovePlugin.Plugin</AssemblyName>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>COM3D2.GripMovePlugin.Plugin</RootNamespace>
    <TargetFramework>net35</TargetFramework>
  </PropertyGroup>

</Project>
